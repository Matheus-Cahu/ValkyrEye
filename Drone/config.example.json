{
  "serial_port": "/dev/ttyUSB0",
  "baud_rate": 115200,
  "outbox_dir": "outbox",
  "database_path": "events.sqlite3",
  "min_battery_percent": 40,
  "capture_count": 3,
  "capture_interval_seconds": 1.0,
  "flight_area_ready": false,
  "sensors": {
    "radar-01": {
      "calibrated": false,
      "servo_zero_deg": 90,
      "yaw_at_servo_zero_deg": 0,
      "servo_direction": 1,
      "min_servo_angle_deg": 45,
      "max_servo_angle_deg": 135
    }
  }
}
