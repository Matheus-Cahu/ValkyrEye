POSTGRES_DB=valkyreye
POSTGRES_USER=valkyreye
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
API_PORT=8080

# Broker MQTT (Mosquitto). Os ESP32 entram com o usuário "radar".
MQTT_PORT=1883
MQTT_RADAR_PASSWORD=troque-esta-senha-do-radar
MQTT_API_PASSWORD=troque-esta-senha-da-api

# Google Earth Engine: coloque a chave em secrets/gee-service-account.json.
# GEE_PROJECT é opcional (padrão: project_id da chave).
GEE_PROJECT=
